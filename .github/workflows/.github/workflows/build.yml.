name: Build Android APK

on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - uses: subosito/flutter-action@v2
        with:
          channel: stable
          cache: true

      - name: Generate Android project around my files
        run: |
          mkdir -p /tmp/dav_src
          cp pubspec.yaml /tmp/dav_src/pubspec.yaml
          cp main.dart /tmp/dav_src/main.dart
          flutter create --org com.dav --project-name dav_browser --platforms=android .
          cp /tmp/dav_src/pubspec.yaml pubspec.yaml
          cp /tmp/dav_src/main.dart lib/main.dart
          rm -rf test

      - name: Point the updater at this repository
        run: |
          sed -i "s#OWNER/REPO#${{ github.repository }}#" lib/main.dart
          grep -n "kUpdateRepo =" lib/main.dart

      - name: Patch Android settings
        run: |
          sed -i 's#<application#<uses-permission android:name="android.permission.INTERNET"/>\n    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>\n    <application#' android/app/src/main/AndroidManifest.xml
          sed -i 's/android:label="dav_browser"/android:label="Dav Browser"/' android/app/src/main/AndroidManifest.xml
          sed -i 's/minSdk = flutter.minSdkVersion/minSdk = 24/' android/app/build.gradle.kts || true
          sed -i 's/minSdkVersion flutter.minSdkVersion/minSdkVersion 24/' android/app/build.gradle || true

      - name: Add updater, icon and dependencies
        run: |
          flutter pub add ota_update package_info_plus
          flutter pub add --dev flutter_launcher_icons
          cat > flutter_launcher_icons.yaml <<'EOF'
          flutter_launcher_icons:
            android: true
            ios: false
            image_path: "icon.png"
            adaptive_icon_background: "#000000"
            adaptive_icon_foreground: "icon_foreground.png"
          EOF
          dart run flutter_launcher_icons

      - name: Set up permanent signing key
        env:
          KS_B64: ${{ secrets.DAV_KEYSTORE_BASE64 }}
          KS_PASS: ${{ secrets.DAV_KEYSTORE_PASSWORD }}
        run: |
          if [ -z "$KS_B64" ] || [ -z "$KS_PASS" ]; then
            echo "Missing DAV_KEYSTORE_BASE64 or DAV_KEYSTORE_PASSWORD secret"
            exit 1
          fi
          echo "$KS_B64" | base64 -d > "$GITHUB_WORKSPACE/dav-release.jks"
          echo "DAV_KS_FILE=$GITHUB_WORKSPACE/dav-release.jks" >> "$GITHUB_ENV"
          echo "DAV_KS_PASS=$KS_PASS" >> "$GITHUB_ENV"
          python3 - <<'PY'
          p = 'android/app/build.gradle.kts'
          s = open(p).read()
          block = '''    signingConfigs {
              create("release") {
                  storeFile = file(System.getenv("DAV_KS_FILE"))
                  storePassword = System.getenv("DAV_KS_PASS")
                  keyAlias = "dav"
                  keyPassword = System.getenv("DAV_KS_PASS")
              }
          }

          '''
          if '    buildTypes {' not in s or 'signingConfigs.getByName("debug")' not in s:
              raise SystemExit("Could not patch signing config")
          s = s.replace('    buildTypes {', block + '    buildTypes {', 1)
          s = s.replace('signingConfigs.getByName("debug")', 'signingConfigs.getByName("release")')
          open(p, 'w').write(s)
          PY

      - run: flutter pub get

      - run: flutter build apk --release --build-name=0.1.${{ github.run_number }} --build-number=${{ github.run_number }}

      - name: Publish APK as a downloadable release
        uses: softprops/action-gh-release@v2
        with:
          tag_name: v0.1.${{ github.run_number }}
          name: Dav browser build ${{ github.run_number }}
          files: build/app/outputs/flutter-apk/app-release.apk
